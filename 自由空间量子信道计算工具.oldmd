## 空间损耗/AB镜间损耗计算器
<div class="table-container">
    <div class="table-title">空间损耗/AB镜间损耗计算器</div>
    <table id="lossCalculationTable" class="display">
        <thead>
            <tr>
                <th>参数</th>
                <th>值</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>发散角 (半角，urad)</td>
                <td><input type="number" id="divergenceAngle" value="35" min="0" max="100000" step="1"></td>
            </tr>
            <tr>
                <td>通信距离 (km)</td>
                <td><input type="number" id="distance" value="30" min="0"></td>
            </tr>
            <tr>
                <td>发送口径 (m)</td>
                <td><input type="number" id="transmitterDiameter" value="0.1" step="0.02"></td>
            </tr>
            <tr>
                <td>接收口径 (m)</td>
                <td><input type="number" id="receiverDiameter" value="0.28" step="0.02"></td>
            </tr>
            <tr id="spaceLossRow">
                <td>空间损耗</td>
                <td id="spaceLoss">0.07111111</td>
            </tr>
            <tr id="spaceLossdBRow">
                <td>空间损耗 (负数，dB)</td>
                <td id="spaceLossdB">-11.48</td>
            </tr>
            <tr>
                <td>大气损耗 (负数，dB)</td>
                <td><input type="number" id="atmosphericLoss" value="-6.02" max="0" step="0.01"></td>
            </tr>
            <tr id="ABLossRow">
                <td>A镜-B镜损耗</td>
                <td id="ABLoss">0.01777778</td>
            </tr>
            <tr id="ABLossdBRow">
                <td>A镜-B镜损耗 (负数，dB)</td>
                <td id="ABLossdB">-17.50</td>
            </tr>
        </tbody>
    </table>
</div>

<script>
function calculateSpaceLoss() {
    // 获取用户输入的值
    var divergenceAngle = parseFloat(document.getElementById('divergenceAngle').value);
    var distance = parseFloat(document.getElementById('distance').value);
    var transmitterDiameter = parseFloat(document.getElementById('transmitterDiameter').value);
    var receiverDiameter = parseFloat(document.getElementById('receiverDiameter').value);
    var atmosphericLossdB = parseFloat(document.getElementById('atmosphericLoss').value);

        // 验证大气损耗dB是否为非正数
    if (atmosphericLossdB > 0) {
        alert("大气损耗(dB)必须小于或等于 0");
        return;
    }

    // 验证输入是否为有效数字
    if (!isNaN(divergenceAngle) && !isNaN(distance) && !isNaN(transmitterDiameter) && !isNaN(receiverDiameter) && !isNaN(atmosphericLossdB)) {
        // 计算空间损耗的公式
        if (receiverDiameter <= transmitterDiameter + 2 * divergenceAngle * distance / 1000){
            var spaceLoss = Math.pow((receiverDiameter / (transmitterDiameter + 2 * divergenceAngle * distance / 1000)), 2);
        }
        else {
            var spaceLoss = 1;
        }
        // 计算A镜-B镜损耗的公式
        var spaceLossdB = 10 * Math.log10(spaceLoss);
        var atmosphericLoss = Math.pow(10, atmosphericLossdB / 10);
        var ABLoss = spaceLoss * atmosphericLoss;
        var ABLossdB = 10 * Math.log10(ABLoss);

        // 显示结果
        document.getElementById('spaceLoss').innerText = spaceLoss.toFixed(8);
        document.getElementById('spaceLossdB').innerText = spaceLossdB.toFixed(2);
        document.getElementById('ABLoss').innerText = ABLoss.toFixed(8);
        document.getElementById('ABLossdB').innerText = ABLossdB.toFixed(4);
    } else {
        document.getElementById('spaceLoss').innerText = 'N/A';
        document.getElementById('spaceLossdB').innerText = 'N/A';
        document.getElementById('ABLoss').innerText = 'N/A';
        document.getElementById('ABLossdB').innerText = 'N/A';
    }

}

// 监听所有输入框的输入事件，实时更新计算结果
document.getElementById('divergenceAngle').addEventListener('input', calculateSpaceLoss);
document.getElementById('distance').addEventListener('input', calculateSpaceLoss);
document.getElementById('transmitterDiameter').addEventListener('input', calculateSpaceLoss);
document.getElementById('receiverDiameter').addEventListener('input', calculateSpaceLoss);
document.getElementById('atmosphericLoss').addEventListener('input', calculateSpaceLoss);

calculateSpaceLoss();
</script>


